# Run the resulting image as linux/amd64, including on a Rosetta-enabled Linux VM.
FROM ubuntu:22.04@sha256:0a9887931b0e38af2e3487ed39e29436b0535c4f3f52e57745baaf79d1898956
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl python3 patch flex bison texinfo \
    zlib1g-dev g++-mingw-w64-x86-64=10.3.0-14ubuntu1+24.3 wine64 file \
    && rm -rf /var/lib/apt/lists/*
ENV WINEDEBUG=-all WINEARCH=win64 WINEDLLOVERRIDES="mscoree,mshtml="
