diff --git a/gcc/doc/extend.texi b/gcc/doc/extend.texi
--- a/gcc/doc/extend.texi
+++ b/gcc/doc/extend.texi
@@ -8358,8 +8358,16 @@
 @end smallexample
 
 Permissible values for this parameter are @code{supervisor},
-@code{machine}, and @code{rnmi}.  If there is no parameter, then it
-defaults to @code{machine}.
+@code{machine}, @code{rnmi}, and @code{WCH-Interrupt-fast}.  If there is
+no parameter, then it defaults to @code{machine}.
+
+The @code{WCH-Interrupt-fast} convention requires QingKe hardware register
+stacking to be enabled by the runtime.  It omits software saves for the
+sixteen hardware-preserved integer registers (@code{ra}, @code{a0} through
+@code{a7}, and @code{t0} through @code{t6}).  Used callee-saved registers
+are still preserved by software.  The handler returns with @code{mret}.
+Do not use this convention for interrupts which can exceed the configured
+hardware stacking depth.
 
 @atindex @code{riscv_vector_cc}, RISC-V
 @item riscv_vector_cc
diff --git a/gcc/testsuite/gcc.target/riscv/wch-fast-interrupt.c b/gcc/testsuite/gcc.target/riscv/wch-fast-interrupt.c
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/wch-fast-interrupt.c
@@ -0,0 +1,23 @@
+/* { dg-do compile } */
+/* { dg-options "-march=rv32imac_zicsr -mabi=ilp32 -Os -msave-restore -Werror=attributes" } */
+
+extern void work (void);
+
+__attribute__ ((interrupt ("WCH-Interrupt-fast")))
+void leaf (void)
+{
+  __asm__ volatile ("" ::: "a0", "t0");
+}
+
+__attribute__ ((interrupt ("WCH-Interrupt-fast")))
+void nonleaf (void)
+{
+  __asm__ volatile ("" ::: "s0", "s1", "a0", "t0");
+  work ();
+}
+
