+/* QingKe hardware stacking preserves these sixteen integer registers.
+   Keep this independent of call_used_regs: floating-point registers and
+   registers affected by other calling conventions are not hardware-saved.  */
+static bool
+riscv_wch_hardware_saved_reg_p (unsigned int regno)
+{
+  return regno == RETURN_ADDR_REGNUM
+         || (regno >= 5 && regno <= 7)
+         || (regno >= 10 && regno <= 17)
+         || (regno >= 28 && regno <= 31);
+}
+
+static bool
+riscv_wch_fast_interrupt_p ()
+{
+  return cfun->machine->interrupt_handler_p
+         && cfun->machine->interrupt_mode == WCH_FAST_MODE;
+}
+
