   {NULL, 0, 0, 0, 0}
 };
 
@@ -2291,6 +2292,12 @@ riscv_parse_check_conflicts (riscv_parse_subset_t *rps)
 			  xlen);
       no_conflict = false;
     }
+  if (riscv_subset_supports (rps, "xwchc")
